# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies -- unanchored so this also covers apps/*/node_modules and packages/*/node_modules
# in the npm-workspaces monorepo layout, not just the workspace root's
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js -- unanchored for the same reason (each app under apps/* has its own .next/out)
.next/
out/

# production
build

# turborepo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI local cache (contains project ref/org id/pooler host)
/supabase/.temp/

# local schema/data backups (data dumps can contain auth.users password hashes)
backups/*_data_backup.sql
